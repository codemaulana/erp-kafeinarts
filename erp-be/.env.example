# ==============================================================================
# Environment Configuration Template - Kafeinarts ERP Backend
# ==============================================================================

# Server configuration
PORT=8000
APP_ENV=development
APP_NAME="Kafeinarts ERP API"

# SQLite Database path
DB_PATH=./storage/erp.db

# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
JWT_EXPIRATION_HOURS=72

# CORS Allowed Origins (separated by comma)
CORS_ORIGINS=http://localhost:3008,http://localhost:8484,http://localhost:9000,http://localhost:9001,http://localhost:8080,http://localhost:3000,http://localhost:8000,http://127.0.0.1:3008,http://127.0.0.1:9000
