# ==============================================================================
# Port Configuration - Kafeinarts ERP Docker Local
# ==============================================================================
# Port Frontend SPA (Nginx Reverse Proxy): http://localhost:3008
# Port Backend API (Direct Access / Debug): http://localhost:8484
#
# Catatan: Port 3008 & 8484 dipilih sebagai default agar tidak bentrok dengan
# port lokal umum (seperti 3000 / 8080). Anda bebas mengubah port ini jika diinginkan.
FRONTEND_PORT=3008
BACKEND_PORT=8484
